#!/usr/bin/env bash
# A throwaway Herdr app on its own core, home and display, so changes get tried
# without touching the real one. The display is a headless Weston with
# Xwayland: nothing shows on the desktop, frames never stall, and screenshots
# and fake mouse input stay inside it (no portal prompt, the real pointer
# never moves).
#
#   scripts/sandbox up            build, start the display, the core and the window
#   scripts/sandbox restart       rebuild and restart the window (terminals live on)
#   scripts/sandbox do <action> [json]   / status   drive it (herdr-app do / status)
#   scripts/sandbox shot [file]   screenshot of the window
#   scripts/sandbox move|click|drag|type|key|hold|release ...   fake input (window px, see sandbox-input.py)
#   scripts/sandbox log           the window's log
#   scripts/sandbox opened        links the window asked to open (logged, never opened)
#   scripts/sandbox hc <args>     hc against the sandbox core
#   scripts/sandbox down          stop everything and delete it
#
# HERDR_APP_SANDBOX=<name> runs a second one side by side. HERDR_APP_BIN runs
# another herdr-app (an installed copy, to try updates) instead of this build.
# HERDR_APP_SANDBOX_ROOT selects an absolute scratch directory. It must be new
# or carry this sandbox's ownership marker; cleanup refuses unrelated folders.
# HERDR_APP_SANDBOX_CORE selects a test hc binary, without installing it.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
name=${HERDR_APP_SANDBOX:-sandbox}
[[ $name =~ ^[a-zA-Z0-9_-]+$ ]] || { echo 'invalid sandbox name' >&2; exit 2; }
root=${HERDR_APP_SANDBOX_ROOT:-/var/tmp/herdr-app-$name}
if [[ $root != /* || $root == / || $root == "$HOME" || $root != "$(realpath -m -- "$root")" || -L $root ]]; then
  echo 'sandbox root must be a canonical absolute scratch path, not /, HOME or a symlink' >&2
  exit 2
fi
bin=${HERDR_APP_BIN:-$here/../target/debug/herdr-app}
export HC_SESSION=herdr-app-$name HERDR_APP_HOME=$root/home
# The core's state (machines, terminals) lives and dies with the sandbox:
# a machine added in one run must not follow the next one there.
export XDG_STATE_HOME=$root/state
export XDG_CONFIG_HOME=$root/config XDG_CACHE_HOME=$root/cache XDG_DATA_HOME=$root/data
export XDG_RUNTIME_DIR=$root/runtime TMPDIR=$root/tmp
# Sounds would play on the real speakers.
export HERDR_APP_NO_SOUND=1

# The private X display, once started (Weston picks the number).
if [[ -f $root/display ]]; then export DISPLAY=$(cat "$root/display"); fi

ours() { { tr '\0' '\n' <"/proc/$1/environ"; } 2>/dev/null | grep -qx "HERDR_APP_HOME=$HERDR_APP_HOME"; }

owned_root() {
  [[ -f $root/.sandbox-owner && ! -L $root/.sandbox-owner ]] &&
    [[ $(cat "$root/.sandbox-owner") == "$(id -u):$name" ]]
}

prepare_root() {
  if [[ -e $root ]] && ! owned_root; then
    echo "refusing unowned sandbox root: $root (choose a new directory)" >&2
    return 1
  fi
  umask 077
  mkdir -p "$root" "$XDG_RUNTIME_DIR" "$TMPDIR" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"
  printf '%s:%s\n' "$(id -u)" "$name" >"$root/.sandbox-owner"
  chmod 700 "$XDG_RUNTIME_DIR"
  if [[ -n ${HERDR_APP_SANDBOX_CORE:-} ]]; then
    [[ $HERDR_APP_SANDBOX_CORE == /* && -x $HERDR_APP_SANDBOX_CORE ]] || {
      echo 'HERDR_APP_SANDBOX_CORE must be an absolute executable test-core path' >&2; return 1;
    }
    mkdir -p "$root/bin"
    ln -sfn -- "$HERDR_APP_SANDBOX_CORE" "$root/bin/hc"
  fi
}

export PATH=$root/bin:$PATH

start_display() {
  mkdir -p "$root"
  if [[ -f $root/xpid ]] && kill -0 "$(cat "$root/xpid")" 2>/dev/null; then
    ours "$(cat "$root/xpid")" || { echo 'refusing a compositor PID not owned by this sandbox' >&2; return 1; }
    return 0
  fi
  rm -f "$root/weston.log" "$root/display"
  weston --backend=headless --xwayland --socket="herdr-app-$name" --width=1400 --height=900 \
    --log="$root/weston.log" >/dev/null 2>&1 &
  echo $! >"$root/xpid"
  for _ in $(seq 50); do
    local d
    d=$(grep -o 'xserver listening on display :[0-9]*' "$root/weston.log" 2>/dev/null | grep -o ':[0-9]*$' || true)
    if [[ -n $d ]]; then
      echo "$d" >"$root/display"
      export DISPLAY=$d
      return 0
    fi
    sleep 0.1
  done
  echo "the sandbox display did not start; see $root/weston.log" >&2
  return 1
}

stop_window() {
  [[ -f $root/pid ]] || return 0
  local pid
  pid=$(cat "$root/pid")
  if ours "$pid"; then
    kill "$pid"
    for _ in $(seq 50); do ours "$pid" || break; sleep 0.1; done
  fi
  rm -f "$root/pid"
}

start_window() {
  (cd "$here/.." && cargo build)
  start_display
  mkdir -p "$HERDR_APP_HOME" "$root/bin"
  # Opening a link would reach the real browser: log it instead (`scripts/sandbox opened`).
  for opener in xdg-open open; do
    printf '#!/bin/sh\nprintf "%%s\\n" "$*" >>%q\n' "$root/opened" >"$root/bin/$opener"
    chmod +x "$root/bin/$opener"
  done
  PATH=$root/bin:$PATH WAYLAND_DISPLAY= setsid "$bin" >"$root/app.log" 2>&1 </dev/null &
  echo $! >"$root/pid"
  for _ in $(seq 100); do
    "$bin" status >/dev/null 2>&1 && { echo "sandbox $name is up on $DISPLAY (log: $root/app.log)"; return 0; }
    ours "$(cat "$root/pid")" || { cat "$root/app.log"; echo "sandbox $name died" >&2; return 1; }
    sleep 0.2
  done
  echo "sandbox $name did not answer; see $root/app.log" >&2
  return 1
}

private_display() {
  if ! owned_root || [[ ! -f $root/xpid || ! -f $root/display ]] || ! ours "$(cat "$root/xpid")"; then
    echo 'no owned private display; run sandbox up first' >&2
    return 1
  fi
  local saved_display
  saved_display=$(cat "$root/display")
  [[ $saved_display =~ ^:[0-9]+$ ]] || { echo 'invalid private display record' >&2; return 1; }
  export DISPLAY=$saved_display
}

input() {
  private_display
  uv run -q --with python-xlib python "$here/sandbox-input.py" "$@"
}

case ${1:-} in
  up | restart) prepare_root; stop_window; start_window ;;
  down)
    [[ -e $root ]] || { echo "sandbox $name is already gone"; exit 0; }
    owned_root || { echo "refusing cleanup of unowned sandbox root: $root" >&2; exit 1; }
    stop_window
    hc server stop >/dev/null 2>&1 || true
    if [[ -f $root/xpid ]]; then
      display_pid=$(cat "$root/xpid")
      if ours "$display_pid"; then kill "$display_pid" 2>/dev/null || true; fi
    fi
    rm -rf -- "$root"
    echo "sandbox $name is gone"
    ;;
  do | status) exec "$bin" "$@" ;;
  shot)
    private_display
    out=${2:-$root/shot.png}
    import -display "$DISPLAY" -window Herdr "$root/full.png"
    magick "$root/full.png" -resize '1100x>' "$out"
    echo "$out"
    ;;
  move | click | drag | type | key | hold | release | sequence) input "$@" ;;
  log) cat "$root/app.log" ;;
  opened) cat "$root/opened" 2>/dev/null || true ;;
  hc) shift; exec hc "$@" ;;
  *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
